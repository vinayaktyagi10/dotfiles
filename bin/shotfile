#!/bin/bash
# ShotFile: Select area -> Save to file (and optional swappy edit)
# Requires: grim, slurp, swappy
DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +'%Y%m%d_%H%M%S_screenshot.png')"

grim -g "$(slurp)" - > "$FILE"
notify-send "Screenshot" "Saved to $FILE"

# Optional: Open in Swappy for editing
swappy -f "$FILE"